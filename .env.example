# Copy to .env.local for local development. Set the real values in Vercel
# (Project settings > Environment Variables) and in the Claude cloud environment.
# Every integration is optional: if a group is missing, the site still works and
# the forms point people to WhatsApp instead.

# ─── Site ────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://www.rawdahtours.co.uk

# Link to the traveller onboarding app (built by another developer). Leave empty to hide it.
NEXT_PUBLIC_ONBOARDING_APP_URL=

# Set to "true" on a preview deployment to show the August 2026 trip as a
# bookable demo (never shown in production).
BOOKING_DEMO=true

# ─── Supabase (stores bookings and enquiries) ────────────────────────────────
SUPABASE_URL=https://your-project-ref.supabase.co
# Server-side only. Never expose in the browser.
SUPABASE_SERVICE_ROLE_KEY=

# ─── Stripe (card deposits) ──────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ─── Resend (emails) ─────────────────────────────────────────────────────────
RESEND_API_KEY=re_...
EMAIL_FROM=Rawdah Tours <noreply@rawdahtours.co.uk>
EMAIL_OWNER_TO=rawdahtours@gmail.com

# ─── Bank transfer details (shown to customers who choose bank transfer) ─────
BANK_ACCOUNT_NAME=
BANK_SORT_CODE=
BANK_ACCOUNT_NUMBER=

# ─── Admin page (/admin) ─────────────────────────────────────────────────────
# Basic-auth login for the bookings list. If unset, /admin is disabled.
ADMIN_USER=rawdah
ADMIN_PASSWORD=
